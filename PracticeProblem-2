class Node{
    int data;
    Node next=null;
    Node(int data){
        this.data=data;
    }
}
public class LinkedList{
    public static void main(String[] args){
        Node a=new Node(25);
        Node b=new Node(50);
        Node c=new Node(75);
        Node d=new Node(100);
        Node e=new Node(125);
        a.next=b;
        b.next=c;
        c.next=d;
        d.next=e;
        System.out.println("a->data:"+a.data);
        System.out.println("b->data:"+b.data);
        System.out.println("c->data:"+c.data);
        System.out.println("d->data:"+d.data);
        System.out.println("e->data:"+e.data);
        System.out.println("a->next->b->data:"+a.next.data);
        System.out.println("a->next->b->next->c->data:"+a.next.next.data);
        System.out.println("a->next->next->next->d->data:"+a.next.next.next.data);
        System.out.println("a->next->next->next->next->e->data:"+a.next.next.next.next.data);
    }
}
