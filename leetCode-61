class Solution{
   public ListNode rotateRight(ListNode head, int k) {
        if (head == null || head.next == null) {
            return head;
        }
        int count = 1;
        ListNode temp = head;
        while (temp.next != null) {
            count++;
            temp = temp.next;
        }
        ListNode tail = temp;
        k = k % count;
        if (k == 0) {
            return head;
        }
        tail.next = head;
        int steps = count - k;
        temp = head;
        while (steps > 1) {
            temp = temp.next;
            steps--;
        }
        head = temp.next;
        temp.next = null;
        return head;
    }
}
 
