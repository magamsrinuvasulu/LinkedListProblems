public class Solution {
    public ListNode hasCycle(ListNode head) {
        if(head==null||head.next==null){
            return null;
        }
        ListNode a=head;
        ListNode b=head;
        while(b!=null&&b.next!=null){
            a=a.next;
            b=b.next.next;
            if(a==b){
                return a;
            }
        }
        return null;
    }
    public ListNode detectCycle(ListNode head) {
        ListNode fast=hasCycle(head);
        if(fast==null){
            return null;
        }
        ListNode slow=head;
        while(slow!=fast){
            slow=slow.next;
            fast=fast.next;
        }
        return fast;
    }
}
