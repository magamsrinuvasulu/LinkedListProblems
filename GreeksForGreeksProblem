class Node {
    int data;
    Node next;

    Node(int new_data) {
        data = new_data;
        next = null;
    }
}

class GfG {

    static Node segregate(Node head) {
        Node h0 = new Node(0);
        Node h1 = new Node(1);
        Node h2 = new Node(2);

        Node t0 = h0, t1 = h1, t2 = h2;
        Node temp = head;

        while (temp != null) {
            if (temp.data == 0) {
                t0.next = temp;
                t0 = t0.next;
            } 
            else if (temp.data == 1) {
                t1.next = temp;
                t1 = t1.next;
            } 
            else {
                t2.next = temp;
                t2 = t2.next;
            }

            temp = temp.next;
        }

        // Connect 0-list with 1-list or 2-list
        t0.next = (h1.next == null) ? h2.next : h1.next;

        // Connect 1-list with 2-list
        t1.next = h2.next;

        // End the list
        t2.next = null;

        return h0.next;
    }

    public static void main(String[] args) {

        Node head = new Node(1);
        head.next = new Node(2);
        head.next.next = new Node(2);
        head.next.next.next = new Node(1);
        head.next.next.next.next = new Node(2);
        head.next.next.next.next.next = new Node(0);
        head.next.next.next.next.next.next = new Node(2);
        head.next.next.next.next.next.next.next = new Node(2);

        head = segregate(head);

        while (head != null) {
            System.out.print(head.data);

            if (head.next != null) {
                System.out.print(" -> ");
            }

            head = head.next;
        }

        System.out.println();
    }
}
